{
  "name": "turbo-filter-using-tasks-repro",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "turbo-filter-using-tasks-repro",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/app": {
      "version": "0.0.0",
      "dependencies": {
        "lib": "*"
      }
    },
    "node_modules/app": {
      "resolved": "apps/app",
      "link": true
    },
    "node_modules/lib": {
      "resolved": "packages/lib",
      "link": true
    },
    "packages/lib": {
      "version": "0.0.0"
    }
  }
}
